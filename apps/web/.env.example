# ═══════════════════════════════════════════════════════════
# Local dev .env template for apps/web (Nuxt 3 storefront).
# Copy to apps/web/.env and fill in values.
# Production values live in /opt/wanjukong/.env (see deploy/.env.production.example).
# ═══════════════════════════════════════════════════════════

# Public API base URL the browser uses to reach the API server.
# In production this is the same origin as the storefront (Nginx proxies /api).
NUXT_PUBLIC_API_BASE=http://localhost:3001

# PayPal sandbox/live Client ID — must match apps/api/.env PAYPAL_CLIENT_ID.
# Exposed to the browser so the PayPal JS SDK can render the checkout button.
NUXT_PUBLIC_PAYPAL_CLIENT_ID=

# Canonical public URL. Used for hreflang alternates, sitemap entries, og:url,
# JSON-LD Organization `url`, and the `siteUrl` runtime config.
# REQUIRED in production. Nuxt config throws at startup if this resolves to a
# localhost/127.0.0.1 address while NODE_ENV=production (see nuxt.config.ts).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only URL the Nuxt SSR process uses to reach the API.
# Lets SSR hit the API on the internal docker network (e.g. http://api:3001)
# instead of bouncing back out through Nginx via the public hostname. Falls
# back to NUXT_PUBLIC_API_BASE if unset.
NUXT_API_BASE_INTERNAL=
