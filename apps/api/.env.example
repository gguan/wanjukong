# ═══════════════════════════════════════════════════════════
# Local dev .env template for apps/api
# Copy to apps/api/.env and fill in values.
# Production uses deploy/.env.production.example instead.
# ═══════════════════════════════════════════════════════════

PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wanjukong

# Admin/customer session (required — use a random 64+ character string in production)
SESSION_SECRET=dev-session-secret-change-in-production

# Storefront base URL used in email links
APP_BASE_URL=http://localhost:3000

# ─── Express / session behaviour ──────────────────────────
# Number of reverse-proxy hops to trust for X-Forwarded-* headers. Defaults to 1
# (single Nginx in front). Raise if you sit behind Cloudflare + Nginx etc.
# Bad values break client IP detection AND session cookie issuance (req.secure=false).
TRUST_PROXY=1

# Force session cookie `Secure` flag on/off explicitly. Leave empty to auto-detect
# from NODE_ENV=production. Set to "false" only for local HTTPS testing against
# self-signed certs where the cookie would otherwise be dropped.
COOKIE_SECURE=

# ─── Email ────────────────────────────────────────────────
# Transport priority: Resend > SMTP > console.
# - RESEND_API_KEY set  → use Resend API (recommended for 海外 users)
# - SMTP_HOST+PORT set  → fall back to SMTP (e.g. 腾讯云 SES for 国内)
# - Neither             → emails are logged to console (dev only)
RESEND_API_KEY=
# 腾讯云 SES SMTP endpoint by region (NOT smtp.exmail.qq.com — that's 企业邮箱):
#   广州  gz-smtp.qcloudmail.com
#   新加坡 sg-smtp.qcloudmail.com
#   默认/北京 smtp.qcloudmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=no-reply@overrealm.shop
SMTP_PASS=
# "From" address used by both Resend and SMTP. Must be on a verified domain.
SMTP_FROM=no-reply@overrealm.shop

# Where /api/public/contact forwards customer submissions. Falls back to
# SMTP_FROM if unset. Usually support@<your-domain>.
CONTACT_INBOX_EMAIL=

# ─── Tencent Cloud COS (product image upload) ─────────────
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=your-bucket-name-1250000000
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_BASE_URL=https://your-bucket-name-1250000000.cos.ap-guangzhou.myqcloud.com

# Upload lifecycle
UPLOAD_TEMP_EXPIRE_HOURS=24

# ─── PayPal (International payment) ───────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── WeChat Mini Program ──────────────────────────────────
WECHAT_PAY_APP_ID=
WECHAT_APP_SECRET=

# ─── WeChat Pay ───────────────────────────────────────────
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=      # 32字节，微信支付控制台设置
WECHAT_PAY_PRIVATE_KEY=     # 商户私钥 PEM（\n转义）
WECHAT_PAY_CERT_SERIAL=     # 商户证书序列号
# WeChat Pay platform public key PEM (download from 商户平台 → API 安全).
# REQUIRED in production — without it, callback signatures cannot be verified.
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=      # 回调地址，必须公网可达

# ─── Translation (DeepL Free API — 500k chars/month free) ─
# https://www.deepl.com/pro-api → sign up → get API key
# Leave empty to use MyMemory fallback (free, no key, lower quality)
DEEPL_API_KEY=
