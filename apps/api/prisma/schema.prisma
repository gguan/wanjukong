generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Session Table (managed by connect-pg-simple) ────────
// Declared here so `prisma db push` won't drop it.
// Do NOT use Prisma to query this table — it's managed by express-session.

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@map("session")
  @@index([expire])
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthCheckLog {
  id        String   @id @default(cuid())
  status    String
  message   String?
  createdAt DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
}

enum SaleType {
  IN_STOCK
  PREORDER
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?    @default("{}")  // {"en":"...","zh-TW":"...","ja":"..."}
  slug      String   @unique
  code      String?
  logo      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  adminAssignments AdminBrandAssignment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  nameI18n  Json?    @default("{}")  // {"en":"...","zh-TW":"...","ja":"..."}
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  nameI18n         Json?         @default("{}")
  slug             String        @unique
  scale            String?
  status           ProductStatus @default(DRAFT)
  imageUrl         String?
  brandId          String
  categoryId       String

  // Homepage featured
  isFeatured       Boolean       @default(false)
  featuredSort     Int           @default(0)

  // Sale type & preorder
  saleType         SaleType      @default(IN_STOCK)
  preorderStartAt  DateTime?
  preorderEndAt    DateTime?
  estimatedShipAt  DateTime?
  depositCents     Int?
  usdDepositCents  Int?             // USD deposit for preorder (分), optional

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand      Brand           @relation(fields: [brandId], references: [id])
  category   Category        @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  images     ProductImage[]
  variants   ProductVariant[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  nameI18n        Json?    @default("{}")
  versionCode     String?
  sku             String   @unique
  manufacturerSku String?
  priceCents      Int              // CNY price in fen (分)
  usdPriceCents   Int?             // USD price in cents (optional)
  stock           Int      @default(0)
  subtitle        String?
  subtitleI18n    Json?    @default("{}")
  specSummary     String?
  specSummaryI18n Json?    @default("{}")
  specifications  String?  @db.Text
  specificationsI18n Json? @default("{}")
  weightGrams     Int?
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  coverImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, sortOrder])
}

// ─── Upload / Image Models ────────────────────────────────

enum UploadFileStatus {
  TEMP
  USED
  DELETED
}

model UploadFile {
  id               String           @id @default(cuid())
  provider         String           @default("tencent-cos")
  bucket           String
  region           String
  objectKey        String           @unique
  fileUrl          String
  originalFileName String?
  mimeType         String?
  sizeBytes        Int?
  status           UploadFileStatus @default(TEMP)
  linkedEntityType String?
  linkedEntityId   String?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  productImages ProductImage[]

  @@index([status, expiresAt])
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  uploadFileId String?
  imageUrl     String
  altText      String?
  sortOrder    Int         @default(0)
  isPrimary    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadFile UploadFile? @relation(fields: [uploadFileId], references: [id])

  @@index([productId, sortOrder])
}

// ─── Storefront Customer Models ──────────────────────────

model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  phone           String?
  wechatOpenId    String?   @unique
  authProvider    String    @default("email") // "email" | "wechat"
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses            CustomerAddress[]
  emailVerifications   CustomerEmailVerification[]
  passwordResets       CustomerPasswordReset[]
  orders               Order[]
  paymentIntents       PaymentIntent[]

  @@index([email])
}

model CustomerAddress {
  id              String   @id @default(cuid())
  customerId      String
  label           String?
  fullName        String
  phone           String?
  country         String
  stateOrProvince String?
  city            String
  district        String?  // 区/县 — used for Chinese addresses; null for international
  addressLine1    String   // Street / detailed address
  addressLine2    String?
  postalCode      String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerEmailVerification {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
}

model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
}

// ─── Payment Intent ─────────────────────────────────────

enum PaymentProvider {
  PAYPAL
  WECHAT_PAY
}

enum PaymentIntentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  ORDER_CREATED
}

model PaymentIntent {
  id                  String              @id @default(cuid())
  provider            PaymentProvider     @default(PAYPAL)
  // PayPal
  paypalOrderId       String?             @unique
  // WeChat Pay
  wechatPrepayId      String?
  wechatOutTradeNo    String?             @unique
  wechatTransactionId String?

  customerId            String?
  email                 String?
  currency              String              @default("USD")
  amountCents           Int
  cartSnapshotJson      String              @db.Text
  shippingAddressJson   String?             @db.Text
  couponCode            String?
  discountCents         Int?
  status                PaymentIntentStatus @default(CREATED)
  isBalance             Boolean             @default(false)  // true = balance payment, false = deposit/full
  capturedAt       DateTime?
  orderId          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([paypalOrderId])
  @@index([wechatOutTradeNo])
  @@index([status])
}

// ─── Coupon Model ─────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Int          // percent (0-100) or cents
  minOrderCents  Int          @default(0)
  maxUsageTimes  Int?         // null = unlimited
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── Order Enums ──────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID   // Deposit paid, balance pending (Sideshow-style preorder)
  PAID
  FAILED
  REFUNDED
}

// ─── Order Models ─────────────────────────────────────────

model Order {
  id                    String        @id @default(cuid())
  orderNo               String        @unique
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)

  // Customer link (nullable for guest orders)
  customerId            String?
  guestAccessTokenHash  String?

  // Customer / contact
  fullName              String
  email                 String
  phone                 String?

  // Shipping address
  country               String
  stateOrProvince       String?
  city                  String
  addressLine1          String
  addressLine2          String?
  postalCode            String?

  // Pricing
  currency              String        @default("USD")
  couponCode            String?
  discountCents         Int         @default(0)
  subtotalPriceCents    Int
  totalPriceCents       Int

  // Preorder (Sideshow-style two-phase payment)
  isPreorder            Boolean       @default(false)
  depositCents          Int           @default(0)   // Amount paid at checkout (deposit + full-price in-stock items)
  balanceCents          Int           @default(0)   // Remaining balance for preorder items
  depositPaidAt         DateTime?
  balancePaidAt         DateTime?
  balanceDueBy          DateTime?
  gracePeriodEndsAt     DateTime?     // createdAt + 24h — cancel freely before this
  balancePaypalOrderId  String?       // Separate PayPal order for balance payment
  balanceWechatTransactionId String?  // Separate WeChat transaction for balance

  // Payment
  paypalOrderId         String?
  wechatTransactionId   String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  refunds        Refund[]
  shipments      Shipment[]
  paymentIntents PaymentIntent[]

  @@index([customerId])
  @@index([email])
  @@index([status])
}

// ─── Refund Model ─────────────────────────────────────────

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  amountCents     Int
  reason          String?
  status          RefundStatus @default(PENDING)
  wechatRefundId  String?      // 微信退款单号（微信返回）
  wechatRefundNo  String?      @unique  // 商户退款单号
  createdBy       String?      // 操作管理员 ID
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id                    String  @id @default(cuid())
  orderId               String
  productId             String
  variantId             String?

  // Snapshots (preserve historical info)
  productNameSnapshot   String
  productSlugSnapshot   String
  variantNameSnapshot   String?
  skuSnapshot           String?
  brandNameSnapshot     String?
  categoryNameSnapshot  String?
  coverImageUrlSnapshot String?
  scaleSnapshot         String?

  unitPriceCents        Int
  quantity              Int
  totalPriceCents       Int

  // Preorder snapshot
  isPreorder            Boolean @default(false)
  depositCents          Int     @default(0)  // Deposit amount for this line (preorder only)

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
}

// ─── Shipment Models ─────────────────────────────────────

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum ShippingCarrier {
  SF_EXPRESS
  YTO
  ZTO
  STO
  YUNDA
  EMS
  DHL
  FEDEX
  UPS
  OTHER
}

model Shipment {
  id                  String          @id @default(cuid())
  orderId             String
  carrier             ShippingCarrier
  carrierName         String?         // when carrier=OTHER
  trackingNumber      String
  status              ShipmentStatus  @default(PENDING)

  isInternational     Boolean         @default(false)
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  notes               String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  order               Order           @relation(fields: [orderId], references: [id])
  items               ShipmentItem[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int    @default(1)

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([shipmentId, orderItemId])
  @@index([shipmentId])
}

// ─── Admin Auth Models ───────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  BRAND_MANAGER
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           AdminRole @default(EDITOR)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs        AdminAuditLog[]
  brandAssignments AdminBrandAssignment[]

  @@index([email])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  resource    String?
  resourceId  String?
  metadata    String?  @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model AdminBrandAssignment {
  id          String   @id @default(cuid())
  adminUserId String
  brandId     String
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, brandId])
  @@index([adminUserId])
  @@index([brandId])
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  subject     String
  orderNumber String?
  message     String               @db.Text
  locale      String               @default("en")
  ipAddress   String?
  userAgent   String?
  status      ContactMessageStatus @default(NEW)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}
