.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.login-container {
  width: 100%;
  padding: 0 64rpx;
  text-align: center;
}

/* 品牌 */
.brand-section {
  margin-bottom: 80rpx;
}

.brand-logo-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.04em;
  margin-bottom: 12rpx;
}

.brand-tagline {
  font-size: 28rpx;
}

/* 登录操作 */
.login-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  margin: 0;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
}

.login-hint {
  margin-top: 24rpx;
}

.login-success-text {
  margin-bottom: 32rpx;
}
