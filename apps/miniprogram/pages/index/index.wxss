.page { padding-bottom: 24rpx; }

.hero {
  background: #1a1a1a;
  padding: 60rpx 32rpx 48rpx;
  color: #fff;
}
.hero-title { font-size: 48rpx; font-weight: 700; margin-bottom: 8rpx; }
.hero-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.65); }

.section { margin-top: 32rpx; }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 16rpx;
}
.section-title { font-size: 32rpx; font-weight: 600; }
.section-link { font-size: 24rpx; color: #8c9196; }

.brands-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.brand-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border: 2rpx solid #e3e3e3;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.brand-logo { width: 40rpx; height: 40rpx; }

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
  gap: 16rpx;
}

.product-grid > product-card {
  width: calc(50% - 8rpx);
}
