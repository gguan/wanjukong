.page {
  background: #fff;
  min-height: 100vh;
}

/* Section Header */
.section-header {
  padding: 100rpx 32rpx 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.02em;
}

/* Product Grid — flush 2-column, thin separator */
.product-grid {
  display: flex;
  flex-wrap: wrap;
}

.product-grid product-card {
  display: block;
  width: 50%;
  box-sizing: border-box;
  border-bottom: 2rpx solid #e8e8e8;
}

/* Right column gets left border */
.product-grid product-card:nth-child(even) {
  border-left: 2rpx solid #e8e8e8;
}

/* Loading States */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 64rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}
