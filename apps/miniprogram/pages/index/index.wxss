.page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* Section Header */
.section-header {
  padding: 100rpx 32rpx 24rpx;
  background: #fff;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.02em;
}

/* Product Grid — 2-column with gap between columns */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0;
}

.product-grid product-card {
  display: block;
  width: calc(50% - 2rpx);
  box-sizing: border-box;
  margin-bottom: 4rpx;
}

/* Right column — offset by gap */
.product-grid product-card:nth-child(even) {
  margin-left: 4rpx;
}

/* Loading States */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 64rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}
