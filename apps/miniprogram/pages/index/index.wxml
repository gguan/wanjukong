<!-- 首页 -->
<view class="page">
  <!-- Section Title -->
  <view class="section-header">
    <text class="section-title">推荐产品/PRODUCTS</text>
  </view>

  <!-- Product Grid -->
  <view class="product-grid" wx:if="{{products.length}}">
    <product-card
      wx:for="{{products}}"
      wx:key="id"
      product="{{item}}"
      data-slug="{{item.slug}}"
      bindtap="onTapProduct"
    />
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Load More -->
  <view wx:if="{{loadingMore}}" class="loading-more">
    <text class="loading-text">加载更多...</text>
  </view>

  <!-- No More -->
  <view wx:if="{{!hasMore && products.length > 0}}" class="no-more">
    <text class="no-more-text">— 已显示全部 —</text>
  </view>
</view>
