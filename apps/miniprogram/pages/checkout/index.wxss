/* ─── 页面背景 ─────────────────────────────────────────── */

.page {
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ─── 白色 section 块 ──────────────────────────────────── */

.section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

/* ─── 通用 section 标题行 ──────────────────────────────── */

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.section-link-text {
  font-size: 28rpx;
  color: #999;
}

.section-link-arrow {
  font-size: 30rpx;
  color: #bbb;
}

/* ─── 配送地址 ─────────────────────────────────────────── */

.address-detail {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.address-contact {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ─── 订单明细 ─────────────────────────────────────────── */

.order-item {
  display: flex;
  align-items: center;
  padding-top: 24rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.item-info {
  flex: 1;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-self: stretch;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.item-variant {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.item-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #c75c2a;
  margin-top: 16rpx;
}

.item-qty {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  align-self: center;
}

/* ─── 优惠券 ───────────────────────────────────────────── */

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ─── 优惠券 ───────────────────────────────────────────── */

.coupon-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.coupon-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #111;
}

.coupon-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.coupon-apply-btn {
  background: #111;
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.coupon-apply-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-applied-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.coupon-applied-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-code-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #c75c2a;
}

.coupon-discount-text {
  font-size: 26rpx;
  color: #c75c2a;
}

.coupon-remove-text {
  font-size: 26rpx;
  color: #e51c00;
}

.coupon-error {
  display: block;
  font-size: 24rpx;
  color: #e51c00;
  margin-top: 12rpx;
}

/* ─── 价格清单 ─────────────────────────────────────────── */

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.price-label {
  font-size: 28rpx;
  color: #999;
}

.price-value {
  font-size: 28rpx;
  color: #999;
}

.price-orange {
  color: #c75c2a;
}

.price-dark {
  font-size: 28rpx;
  color: #111;
}

/* ─── 底部结算栏 ────────────────────────────────────────── */

.bottom-spacer {
  height: 160rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #e8e8e8;
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.bar-count {
  font-size: 26rpx;
  color: #999;
  margin-right: 4rpx;
}

.bar-total-label {
  font-size: 28rpx;
  color: #999;
}

.bar-total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #c75c2a;
}

.settle-btn {
  background: #000;
  padding: 0 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settle-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.05em;
}
