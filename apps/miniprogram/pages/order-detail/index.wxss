/* ─── 页面 ────────────────────────────────────────────────── */

.page {
  background: #fff;
  min-height: 100vh;
}

/* ─── 自定义导航栏 ───────────────────────────────────────── */

.custom-nav {
  background: #fff;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.nav-placeholder {
  width: 64rpx;
}

/* ─── 状态区 ─────────────────────────────────────────────── */

.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 24rpx;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 16rpx;
}

.status-badge-btn {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
}

.status-badge-text {
  font-size: 24rpx;
  color: #333;
}

/* ─── 物流追踪 ───────────────────────────────────────────── */

.tracking-section {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 20rpx;
}

.tracking-left {
  flex-shrink: 0;
}

.tracking-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tracking-icon-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #111;
}

.tracking-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tracking-status {
  font-size: 28rpx;
  color: #111;
}

.tracking-copy-btn {
  background: #111;
  border-radius: 40rpx;
  padding: 10rpx 24rpx;
}

.tracking-copy-text {
  font-size: 24rpx;
  color: #fff;
}

/* ─── 进度条 ─────────────────────────────────────────────── */

.progress-bar {
  height: 6rpx;
  background: #e8e8e8;
  margin: 0 32rpx 24rpx;
}

.progress-fill {
  height: 100%;
  width: 25%;
  background: #111;
}

/* ─── 配送地址 ───────────────────────────────────────────── */

.address-section {
  background: #f5f5f5;
  padding: 32rpx;
  margin-bottom: 0;
}

.address-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 12rpx;
}

.address-detail {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.address-contact {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* ─── 商品列表 ───────────────────────────────────────────── */

.items-section {
  padding: 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

.item-card {
  display: flex;
  align-items: flex-start;
  padding-bottom: 24rpx;
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.item-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.item-qty {
  font-size: 26rpx;
  color: #999;
}

.item-total-row {
  display: flex;
  justify-content: flex-end;
  padding-top: 8rpx;
}

.item-total-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

/* ─── 价格清单 ───────────────────────────────────────────── */

.price-section {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

.info-section {
  padding: 24rpx 32rpx 48rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.price-label {
  font-size: 28rpx;
  color: #999;
}

.price-value {
  font-size: 28rpx;
  color: #111;
}

.price-orange {
  color: #c75c2a;
}

/* ─── 底部操作栏 ─────────────────────────────────────────── */

.bottom-spacer {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding: 20rpx 32rpx;
  z-index: 100;
}

.bottom-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn--outline {
  border: 1rpx solid #ddd;
  background: #fff;
}

.action-btn--fill {
  background: #111;
}

.action-text {
  font-size: 28rpx;
  color: #333;
}

.action-text--white {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* ─── 空状态 ─────────────────────────────────────────────── */

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
