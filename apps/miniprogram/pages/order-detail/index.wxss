.page { padding: 0 0 48rpx; }

/* 状态栏 */
.status-bar {
  background: #1a1a1a;
  padding: 32rpx 24rpx;
  color: #fff;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.badge-lg {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}

.status-payment { color: rgba(255,255,255,0.7); }

.status-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  color: rgba(255,255,255,0.85);
}

.copy-btn {
  color: #008060;
  font-weight: 500;
}

/* 商品明细 */
.detail-item {
  display: flex;
  padding: 16rpx 0;
}

.detail-item + .detail-item {
  border-top: 2rpx solid #f0f0f0;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f6f6f7;
}

.item-image-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f6f6f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #303030;
}

.item-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

/* 价格 */
.price-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.total-line { padding-top: 4rpx; }

/* 收货信息 */
.shipping-line {
  display: flex;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.shipping-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8c9196;
}
