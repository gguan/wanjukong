<!-- 订单详情 -->
<view class="page">

  <!-- ─── 自定义导航栏 ─── -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onGoBack">
        <image class="nav-back-icon" src="/assets/back.png" mode="aspectFit" />
      </view>
      <text class="nav-title">订单详情</text>
      <view class="nav-placeholder" />
    </view>
  </view>

  <view wx:if="{{!loading && order}}">

    <!-- ─── 状态区 ─── -->
    <view class="status-section">
      <text class="status-title">{{displayStatus}}</text>
      <view class="status-badge-btn">
        <text class="status-badge-text">当前进度</text>
      </view>
    </view>

    <!-- ─── 物流追踪 ─── -->
    <view class="tracking-section">
      <view class="tracking-left">
        <view class="tracking-icon">
          <text class="tracking-icon-text">%</text>
        </view>
      </view>
      <view class="tracking-right">
        <text class="tracking-status">{{displayStatus}}</text>
        <view class="tracking-copy-btn" bindtap="onCopyOrderNo">
          <text class="tracking-copy-text">暂无单号 | 复制</text>
        </view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" />
    </view>

    <!-- ─── 配送地址 ─── -->
    <view wx:if="{{hasShipping}}" class="address-section">
      <text class="address-label">配送地址</text>
      <text class="address-detail">{{shippingDisplay}}</text>
      <text class="address-contact">{{order.fullName}} {{order.phone}}</text>
    </view>

    <!-- ─── 商品列表 ─── -->
    <view class="items-section">
      <view
        wx:for="{{items}}"
        wx:key="productNameSnapshot"
        class="item-card"
      >
        <image
          class="item-image"
          src="{{item.coverImageUrlSnapshot || ''}}"
          mode="aspectFill"
        />
        <view class="item-info">
          <text class="item-name">{{item.productNameSnapshot}}</text>
          <text class="item-qty">数量：{{item.quantity}}</text>
        </view>
      </view>

      <!-- 实付款 -->
      <view class="item-total-row">
        <text class="item-total-text">实付款{{displayTotal}}</text>
      </view>
    </view>

    <!-- ─── 价格清单 ─── -->
    <view class="price-section">
      <view class="price-row">
        <text class="price-label">商品总价</text>
        <text class="price-value">{{displaySubtotal}}</text>
      </view>
      <view class="price-row">
        <text class="price-label">运费</text>
        <text class="price-value">¥ 0.00</text>
      </view>
      <view class="price-row">
        <text class="price-label">获得积分</text>
        <text class="price-value price-orange">+{{earnedPoints}}</text>
      </view>
    </view>

    <!-- ─── 订单信息 ─── -->
    <view class="info-section">
      <view class="price-row">
        <text class="price-label">订单编号</text>
        <text class="price-value">{{order.orderNo}}</text>
      </view>
      <view class="price-row">
        <text class="price-label">创建时间</text>
        <text class="price-value">{{displayDate}}</text>
      </view>
    </view>

    <!-- ─── 底部操作栏（未支付订单） ─── -->
    <view wx:if="{{isUnpaid}}" class="bottom-spacer" />
    <view wx:if="{{isUnpaid}}" class="bottom-bar">
      <view class="bottom-actions">
        <view class="action-btn action-btn--outline" bindtap="onCancelOrder">
          <text class="action-text">取消订单</text>
        </view>
        <view class="action-btn action-btn--fill" bindtap="onRetryPayment">
          <text class="action-text--white">去支付</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-wrap">
    <text class="empty-text">加载中...</text>
  </view>

</view>
