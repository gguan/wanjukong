<!-- 订单详情 -->
<view class="page" wx:if="{{!loading && order}}">
  <!-- 状态栏 -->
  <view class="status-bar">
    <view class="status-row">
      <view class="badge {{statusClass}} badge-lg">{{displayStatus}}</view>
      <text class="status-payment text-sm">{{displayPayment}}</text>
    </view>
    <view class="status-meta">
      <text class="text-sm">订单号: {{order.orderNo}}</text>
      <text class="copy-btn text-sm" bindtap="onCopyOrderNo">复制</text>
    </view>
    <text class="text-secondary text-sm">{{displayDate}}</text>
  </view>

  <!-- 商品列表 -->
  <view class="card">
    <view class="card-header">商品明细</view>
    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="productNameSnapshot"
        class="detail-item"
      >
        <image
          wx:if="{{item.coverImageUrlSnapshot}}"
          class="item-image"
          src="{{item.coverImageUrlSnapshot}}"
          mode="aspectFill"
        />
        <view wx:else class="item-image-placeholder">
          <text class="text-muted text-xs">无图</text>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.productNameSnapshot}}</text>
          <text wx:if="{{item.variantNameSnapshot}}" class="text-secondary text-sm">{{item.variantNameSnapshot}}</text>
          <view class="item-price-row">
            <text class="text-secondary text-sm">{{item.displayUnitPrice}} x {{item.quantity}}</text>
            <text class="price price-sm">{{item.displayLineTotal}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 价格信息 -->
  <view class="card">
    <view class="card-header">订单金额</view>
    <view class="card-body">
      <view class="price-line total-line">
        <text class="font-semibold">订单总额</text>
        <text class="price price-lg">{{displayTotal}}</text>
      </view>
    </view>
  </view>

  <!-- 收货信息 -->
  <view class="card" wx:if="{{hasShipping}}">
    <view class="card-header">收货信息</view>
    <view class="card-body">
      <view class="shipping-line" wx:if="{{order.fullName}}">
        <text class="shipping-label">收件人</text>
        <text>{{order.fullName}}</text>
      </view>
      <view class="shipping-line" wx:if="{{order.phone}}">
        <text class="shipping-label">电话</text>
        <text>{{order.phone}}</text>
      </view>
      <view class="shipping-line" wx:if="{{order.email}}">
        <text class="shipping-label">邮箱</text>
        <text>{{order.email}}</text>
      </view>
      <view class="shipping-line" wx:if="{{order.addressLine1}}">
        <text class="shipping-label">地址</text>
        <text>{{order.country}} {{order.city}} {{order.addressLine1}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading}}" class="empty">
  <text class="text-secondary">加载中...</text>
</view>
