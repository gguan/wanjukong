.page {
  background: #fff;
  min-height: 100vh;
}

/* ─── Custom Navbar ─────────────────────────────────────── */

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-left: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ─── Hero Image ────────────────────────────────────────── */

.hero {
  width: 100%;
  height: 900rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
}

/* ─── Info Section (dark) ───────────────────────────────── */

.info-section {
  background: #fff;
  padding: 32rpx 32rpx 36rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.price-main {
  font-size: 52rpx;
  font-weight: 600;
  color: #c75c2a;
  letter-spacing: 0.02em;
}

.price-usd {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.45);
  font-weight: 500;
}

.product-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.35;
  margin-bottom: 8rpx;
}

/* ─── Variant Pills (on dark bg) ────────────────────────── */

.variants-section {
  margin-top: 24rpx;
}

.variant-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.variant-pill {
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.7);
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
}

.variant-pill.active {
  color: #fff;
  background: #000;
  border-color: #000;
}

.variant-pill.disabled {
  opacity: 0.3;
  text-decoration: line-through;
}

/* ─── Image Gallery ─────────────────────────────────────── */

.gallery {
  background: #fff;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.gallery-image {
  width: 100%;
  display: block;
  border-radius: 0;
}

/* ─── Description & Specifications Section ──────────────── */

.specs-section {
  background: #ffffff;
  padding: 48rpx 32rpx 64rpx;
}

.specs-block {
  margin-bottom: 40rpx;
}

.specs-block:last-child {
  margin-bottom: 0;
}

.specs-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #000;
  margin-bottom: 24rpx;
  letter-spacing: 0.02em;
}

/* Rich text content — styles applied via rich-text component */
.rich-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  word-break: break-word;
}

/* rich-text 内部 HTML tag 选择器在小程序 wxss 中无效，已移除 */

/* ─── Bottom Bar ────────────────────────────────────────── */

.bottom-spacer {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #1a1a1a;
  z-index: 100;
}

.bar-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  flex-shrink: 0;
}

.bar-cart-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.bar-cart-icon {
  width: 48rpx;
  height: 48rpx;
  filter: invert(1);
}

.bar-cart-badge {
  position: absolute;
  top: -12rpx;
  right: -18rpx;
  width: 34rpx;
  height: 34rpx;
  background: #fff;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-cart-badge-text {
  font-size: 22rpx;
  color: #000;
  font-weight: 700;
  line-height: 1;
}

.bar-cart-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: 0;
  border: none;
  margin: 0;
  padding: 0;
}

.bar-btn::after {
  border: none;
}

.bar-btn--add {
  background: #000;
  color: #fff;
  border: 2rpx solid #fff;
}

.bar-btn--add:active {
  background: #222;
}

.bar-btn--buy {
  background: #fff;
  color: #000;
}

.bar-btn--buy:active {
  background: #e8e8e8;
}

.bar-btn--sold {
  background: #2a2a2a;
  color: rgba(255, 255, 255, 0.3);
}

.bar-btn-disabled {
  flex: 1;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.bar-btn-date {
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.2;
}

.bar-btn-hint {
  font-size: 22rpx;
  color: #000;
  line-height: 1.2;
  margin-top: 6rpx;
}

/* ─── Loading ───────────────────────────────────────────── */

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #fff;
}

.loading-text {
  color: rgba(0, 0, 0, 0.5);
  font-size: 28rpx;
}
