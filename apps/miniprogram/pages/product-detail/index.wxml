<!-- 商品详情 -->
<view class="page" wx:if="{{!loading && product}}">

  <!-- ─── Custom Navbar (transparent, over hero) ─── -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-back" bindtap="onTapBack">
      <image class="nav-back-icon" src="/assets/back.png" mode="aspectFit" />
    </view>
  </view>

  <!-- ─── Hero Image ─── -->
  <view class="hero">
    <image
      wx:if="{{heroImage}}"
      src="{{heroImage}}"
      mode="aspectFill"
      class="hero-image"
    />
    <view wx:else class="hero-placeholder" />
  </view>

  <!-- ─── Info Section (dark bg) ─── -->
  <view class="info-section">
    <!-- Price Row -->
    <view class="price-row">
      <text class="price-main">{{displayPriceCNY}}</text>
      <text wx:if="{{displayPriceUSD}}" class="price-usd">{{displayPriceUSD}}</text>
    </view>

    <!-- Product Name -->
    <view class="product-name">{{product.name}}</view>

    <!-- Variant Selection (on dark bg) -->
    <view wx:if="{{product.variants.length > 1}}" class="variants-section">
      <view class="variant-pills">
        <view
          wx:for="{{product.variants}}"
          wx:key="id"
          class="variant-pill {{selectedVariantId === item.id ? 'active' : ''}} {{item.isSoldOut ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTapVariant"
        >
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <!-- ─── Image Gallery (vertical, all images) ─── -->
  <view class="gallery" wx:if="{{galleryImages.length}}">
    <image
      wx:for="{{galleryImages}}"
      wx:key="*this"
      src="{{item}}"
      mode="widthFix"
      class="gallery-image"
      lazy-load
    />
  </view>

  <!-- ─── Description & Specifications (white bg, rich text) ─── -->
  <view wx:if="{{currentVariant && currentVariant.specifications}}" class="specs-section">
    <view class="specs-block">
      <rich-text nodes="{{currentVariant.specifications}}" class="rich-content" />
    </view>
  </view>

  <!-- ─── Bottom Spacer ─── -->
  <view class="bottom-spacer" />

  <!-- ─── Bottom Bar ─── -->
  <view class="bottom-bar safe-bottom">
    <!-- Cart icon with badge -->
    <view class="bar-cart" bindtap="onTapCart">
      <view class="bar-cart-icon-wrap">
        <image class="bar-cart-icon" src="/assets/cart.png" />
        <view wx:if="{{cartCount > 0}}" class="bar-cart-badge">
          <text class="bar-cart-badge-text">{{cartCount > 99 ? '99+' : cartCount}}</text>
        </view>
      </view>
      <text class="bar-cart-label">购物袋</text>
    </view>

    <!-- Sold Out -->
    <block wx:if="{{isSoldOut}}">
      <button class="bar-btn bar-btn--sold" disabled>SOLD OUT</button>
    </block>

    <!-- Preorder: not yet started -->
    <block wx:elif="{{preorderState === 'upcoming'}}">
      <button class="bar-btn bar-btn--add" bindtap="onAddToCart">加入购物车</button>
      <view class="bar-btn-disabled">
        <text class="bar-btn-date">{{preorderStartDisplay}}</text>
        <text class="bar-btn-hint">开始预售</text>
      </view>
    </block>

    <!-- Preorder: active with deposit -->
    <block wx:elif="{{preorderState === 'active' && depositDisplay}}">
      <button class="bar-btn bar-btn--add" bindtap="onAddToCart">加入购物车</button>
      <button class="bar-btn bar-btn--buy" bindtap="onBuyNow">立即预购，定金 {{depositDisplay}}</button>
    </block>

    <!-- Preorder: active without deposit (full payment) -->
    <block wx:elif="{{preorderState === 'active'}}">
      <button class="bar-btn bar-btn--add" bindtap="onAddToCart">加入购物车</button>
      <button class="bar-btn bar-btn--buy" bindtap="onBuyNow">立即预购</button>
    </block>

    <!-- In stock -->
    <block wx:else>
      <button class="bar-btn bar-btn--add" bindtap="onAddToCart">加入购物车</button>
      <button class="bar-btn bar-btn--buy" bindtap="onBuyNow">立即购买</button>
    </block>
  </view>
</view>

<!-- Loading -->
<view wx:if="{{loading}}" class="loading-state">
  <text class="loading-text">加载中...</text>
</view>
