/* ─── 页面（全局水平 padding）────────────────────────────── */

.page {
  background: #fff;
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ─── 页头（继承 page padding，无需自加）────────────────── */

.page-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 0;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #000;
}

.header-count {
  font-size: 26rpx;
  color: #999;
}

/* ─── 分割线 ─────────────────────────────────────────────── */

.divider-line {
  height: 1rpx;
  background: #e8e8e8;
}

/* ─── 商品列表 ───────────────────────────────────────────── */

.cart-item {
  display: flex;
  align-items: stretch;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.item-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.item-info {
  flex: 1;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.item-variant {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #d0d0d0;
  width: fit-content;
  margin-top: 20rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}

.stepper-btn:active {
  background: #f0f0f0;
}

.stepper-value {
  width: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 52rpx;
  background: #fff;
  border-left: 1rpx solid #d0d0d0;
  border-right: 1rpx solid #d0d0d0;
}

.item-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #c75c2a;
  margin-top: 16rpx;
}

/* ─── 右侧：checkbox + 删除 ─────────────────────────────── */

.item-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.item-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #bbb;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-checkbox.checked {
  border-color: #000;
  background: #000;
}

.item-checkbox.disabled {
  border-color: #d0d0d0;
  background: #f5f5f5;
  opacity: 0.6;
}

.checkbox-check {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.delete-text {
  font-size: 24rpx;
  color: #999;
}

/* ─── 空状态 ─────────────────────────────────────────────── */

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  background: #000;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 64rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

/* ─── 底部结算栏（fixed，脱离 page padding，自己管 padding）*/

.bottom-spacer {
  height: 300rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
}

.bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}

.selected-count {
  font-size: 26rpx;
  color: #333;
}

.select-all-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.select-all-label {
  font-size: 26rpx;
  color: #333;
}

.total-label {
  font-size: 30rpx;
  color: #111;
  font-weight: 500;
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #c75c2a;
}

.bar-divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 0 32rpx;
}

.checkout-btn {
  margin: 0 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #000;
  display: block;
}

.checkout-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.05em;
}
