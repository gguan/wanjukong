.page { padding-bottom: 24rpx; }

/* 购物车列表 */
.cart-list { padding-top: 24rpx; }

.cart-item {
  display: flex;
  align-items: stretch;
  padding: 24rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f6f6f7;
}

.item-info {
  flex: 1;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303030;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-variant {
  margin-top: 4rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* 数量步进器 */
.quantity-stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e3e3e3;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #303030;
  background: #f6f6f7;
}

.stepper-btn:active {
  background: #e3e3e3;
}

.stepper-value {
  width: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 48rpx;
}

/* 删除按钮 */
.item-delete {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}

.delete-text {
  font-size: 24rpx;
  color: #e51c00;
}

/* 空状态 */
.go-shopping-btn {
  margin-top: 32rpx;
  width: 240rpx;
}

/* 底部结算栏 */
.bottom-spacer { height: 140rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
  z-index: 100;
}

.total-section {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: #8c9196;
}

.checkout-btn {
  min-width: 240rpx;
  margin: 0;
}
