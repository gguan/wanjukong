/* ─── 页面 ────────────────────────────────────────────────── */

.page {
  background: #fff;
  min-height: 100vh;
}

/* ─── 自定义导航栏 ───────────────────────────────────────── */

.custom-nav {
  background: #fff;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-home-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.nav-placeholder {
  width: 64rpx;
}

/* ─── Tabs ───────────────────────────────────────────────── */

.tabs {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx 24rpx;
}

.tab {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ddd;
  background: #fff;
}

.tab--active {
  background: #111;
  border-color: #111;
}

.tab-text {
  font-size: 26rpx;
  color: #333;
}

.tab--active .tab-text {
  color: #fff;
}

/* ─── 订单卡片 ───────────────────────────────────────────── */

.order-list {
  padding: 0 32rpx;
}

.order-card {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.order-card:last-child {
  border-bottom: none;
}

/* 订单头 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 26rpx;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  color: #999;
}

/* 商品内容 */
.order-body {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.order-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.order-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.order-qty {
  font-size: 26rpx;
  color: #999;
}

/* 价格 */
.order-price-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.order-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn--outline {
  border: 1rpx solid #ddd;
  background: #fff;
}

.action-btn--fill {
  background: #111;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

.action-text--white {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ─── 空状态 ─────────────────────────────────────────────── */

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
