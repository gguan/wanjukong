<!-- 我的订单 -->
<view class="page">

  <!-- ─── 自定义导航栏 ─── -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onGoHome">
        <image class="nav-home-icon" src="/assets/tabbar/home.png" mode="aspectFit" />
      </view>
      <text class="nav-title">我的订单</text>
      <view class="nav-placeholder" />
    </view>
  </view>

  <!-- ─── 状态 tabs ─── -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab--active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onSwitchTab"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <!-- ─── 订单列表 ─── -->
  <view wx:if="{{!loading && !isEmpty}}" class="order-list">
    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order-card"
    >
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-no">订单编号：{{item.orderNo}}</text>
        <text class="order-status">{{item.displayStatus}}</text>
      </view>

      <!-- 商品内容 -->
      <view class="order-body" data-order-no="{{item.orderNo}}" bindtap="onTapOrder">
        <image
          class="order-image"
          src="{{item.items[0].coverImageUrlSnapshot || ''}}"
          mode="aspectFill"
        />
        <view class="order-info">
          <text class="order-name">{{item.items[0].productNameSnapshot}}</text>
          <text class="order-qty">数量：{{item.items[0].quantity}}</text>
        </view>
      </view>

      <!-- 价格 -->
      <view class="order-price-row">
        <text class="order-price">实付款{{item.displayTotal}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" wx:if="{{item.showPayBtn || item.showViewBtn}}">
        <view wx:if="{{item.showCancelBtn}}" class="action-btn action-btn--outline" data-order-no="{{item.orderNo}}" catchtap="onTapOrder">
          <text class="action-text">取消订单</text>
        </view>
        <view wx:if="{{item.showPayBtn}}" class="action-btn action-btn--fill" data-order-no="{{item.orderNo}}" catchtap="onTapOrder">
          <text class="action-text--white">去支付</text>
        </view>
        <view wx:if="{{item.showViewBtn && !item.showPayBtn}}" class="action-btn action-btn--outline" data-order-no="{{item.orderNo}}" catchtap="onTapOrder">
          <text class="action-text">查看订单</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-wrap">
    <text class="empty-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty-wrap">
    <text class="empty-text">暂无订单</text>
  </view>

</view>
