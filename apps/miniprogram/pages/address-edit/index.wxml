<!-- 新增/编辑收货地址 -->
<view class="page">

  <!-- 微信授权行 -->
  <view class="wechat-row">
    <text class="wechat-row-title">{{editId ? '编辑收货地址' : '新增配送地址'}}</text>
    <text class="wechat-link" bindtap="onWechatImport">点击获取微信授权</text>
  </view>

  <!-- 表单 -->
  <view class="form">

    <!-- 姓名 -->
    <view class="form-row">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        placeholder="请输入姓名"
        placeholder-class="form-placeholder"
        value="{{form.fullName}}"
        bindinput="onInput"
        data-field="fullName"
      />
    </view>
    <view class="form-divider" />

    <!-- 手机号 -->
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        placeholder="请输入手机号"
        placeholder-class="form-placeholder"
        value="{{form.phone}}"
        bindinput="onInput"
        data-field="phone"
        type="number"
      />
    </view>
    <view class="form-divider" />

    <!-- 省/市/区 picker -->
    <picker
      mode="region"
      value="{{regionValue}}"
      bindchange="onRegionChange"
    >
      <view class="form-row form-row--picker">
        <text class="form-label">所在省/市/区</text>
        <view class="form-row-right">
          <text class="{{form.stateOrProvince ? 'form-input form-input--filled' : 'form-placeholder'}}">
            {{form.stateOrProvince ? form.stateOrProvince + '/' + form.city + '/' + form.district : '省/市/区'}}
          </text>
          <text class="form-arrow">›</text>
        </view>
      </view>
    </picker>
    <view class="form-divider" />

    <!-- 详情地址 -->
    <view class="form-detail-wrap">
      <text class="form-label">详情地址</text>
      <textarea
        class="form-textarea"
        placeholder="请输入详细地址"
        placeholder-class="form-placeholder"
        value="{{form.addressLine1}}"
        bindinput="onInput"
        data-field="addressLine1"
        auto-height
        maxlength="100"
      />
    </view>
    <view class="form-divider" />

    <!-- 默认地址 -->
    <view class="form-row form-row--checkbox" bindtap="onToggleDefault">
      <view class="checkbox {{form.isDefault ? 'checkbox--checked' : ''}}">
        <text wx:if="{{form.isDefault}}" class="checkbox-check">✓</text>
      </view>
      <text class="form-label">默认地址</text>
    </view>

  </view>

  <!-- 底部占位 -->
  <view class="bottom-spacer" />

  <!-- 保存按钮 -->
  <view class="bottom-bar">
    <view class="save-btn" bindtap="onSave">
      <text class="save-btn-text">保存</text>
    </view>
  </view>

</view>
