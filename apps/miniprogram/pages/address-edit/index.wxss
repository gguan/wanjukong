/* ─── 页面 ────────────────────────────────────────────────── */

.page {
  background: #fff;
  min-height: 100vh;
}

/* ─── 微信授权行 ─────────────────────────────────────────── */

.wechat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
}

.wechat-row-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.wechat-link {
  font-size: 28rpx;
  color: #07c160;
}

/* ─── 表单 ───────────────────────────────────────────────── */

.form {
  padding: 0 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  min-height: 88rpx;
  box-sizing: border-box;
}

.form-row--picker {
  /* picker wraps the row, same styles */
}

.form-row--checkbox {
  justify-content: flex-start;
  gap: 20rpx;
}

.form-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #111;
  text-align: right;
}

.form-input--filled {
  color: #111;
}

.form-placeholder {
  color: #bbb;
  font-size: 28rpx;
  text-align: right;
}

.form-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

.form-arrow {
  font-size: 32rpx;
  color: #bbb;
  flex-shrink: 0;
}

.form-divider {
  height: 1rpx;
  background: #ebebeb;
}

/* ─── 详情地址 ───────────────────────────────────────────── */

.form-detail-wrap {
  padding: 32rpx 0 24rpx;
}

.form-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #111;
  margin-top: 16rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ─── 默认地址 checkbox ──────────────────────────────────── */

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #bbb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox--checked {
  border-color: #111;
  background: #111;
}

.checkbox-check {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

/* ─── 底部 ───────────────────────────────────────────────── */

.bottom-spacer {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.save-btn {
  background: #000;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.05em;
}
