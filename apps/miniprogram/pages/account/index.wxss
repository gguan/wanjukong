.page {
  min-height: 100vh;
  background: #f6f6f7;
  position: relative;
}

/* ─── Hero Banner ─────────────────────────────────────────── */

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-capsule {
  position: absolute;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
}

.capsule-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

/* ─── Content Card ────────────────────────────────────────── */

.content-card {
  position: relative;
  background: #ffffff;
  margin-top: -100rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding-top: 120rpx; /* room for avatar overlap */
  padding-bottom: 24rpx;
  min-height: 800rpx;
}

/* ─── Avatar ──────────────────────────────────────────────── */

.avatar-wrapper {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #e3e3e3;
  overflow: hidden;
  border: 8rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder-text {
  font-size: 48rpx;
  color: #8c9196;
  font-weight: 700;
}

/* ─── User Name ───────────────────────────────────────────── */

.user-name-row {
  text-align: center;
  margin-bottom: 36rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #303030;
}

/* ─── Stats Row ───────────────────────────────────────────── */

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx 36rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #303030;
}

.stat-label {
  font-size: 24rpx;
  color: #8c9196;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e3e3e3;
}

/* ─── Section Divider ─────────────────────────────────────── */

.section-divider {
  height: 2rpx;
  background: #e3e3e3;
  margin: 0 48rpx;
}

/* ─── Quick Actions ───────────────────────────────────────── */

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 36rpx 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 120rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 52rpx;
}

.action-label {
  font-size: 24rpx;
  color: #303030;
  font-weight: 450;
}

/* ─── Menu List ───────────────────────────────────────────── */

.menu-list {
  padding: 0 48rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.menu-item--last {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #303030;
  font-weight: 450;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c9cccf;
  font-weight: 300;
}

/* ─── Logout ──────────────────────────────────────────────── */

.logout-section {
  padding: 48rpx 48rpx 80rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #ffffff;
  color: #e51c00;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: 2rpx solid #e3e3e3;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #fde8e5;
}
