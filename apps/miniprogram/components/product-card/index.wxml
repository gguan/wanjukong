<view class="product-card">
  <view class="card-image">
    <image
      wx:if="{{product.imageUrl}}"
      src="{{product.imageUrl}}"
      mode="aspectFill"
      class="image"
      lazy-load
    />
    <view wx:else class="placeholder">
      <text class="placeholder-text">No Image</text>
    </view>
    <view wx:if="{{product.displayAvailability === 'SOLD_OUT'}}" class="badge-sold">
      SOLD OUT
    </view>
    <view wx:elif="{{product.displayAvailability === 'PREORDER'}}" class="badge-preorder">
      PRE ORDER
    </view>
  </view>
  <view class="card-body">
    <text class="brand-name">{{product.brand.name}}</text>
    <text class="product-name">{{product.name}}</text>
    <text class="price">¥ {{priceDisplay}}</text>
  </view>
</view>
