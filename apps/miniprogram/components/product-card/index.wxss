.product-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #e3e3e3;
}

.card-image {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 aspect ratio */
}

.card-image .image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.placeholder {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6f6f7;
}

.badge-overlay {
  position: absolute;
  top: 12rpx; left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-warning { background: #fef3c7; color: #92400e; }
.badge-danger { background: #fee2e2; color: #991b1b; }

.card-body { padding: 16rpx 20rpx 20rpx; }

.brand-name {
  display: block;
  font-size: 20rpx;
  color: #8c9196;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}

.product-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #303030;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #616161;
  background: #f6f6f7;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.price-row { display: flex; align-items: baseline; }
.from-label { font-size: 22rpx; color: #8c9196; }
.price { font-size: 28rpx; font-weight: 700; color: #303030; }
