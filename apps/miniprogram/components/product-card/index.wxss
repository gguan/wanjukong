.product-card {
  background: #f5f5f5;
}

.card-image {
  position: relative;
  width: 100%;
  padding-top: 125%; /* 4:5 aspect ratio — taller image */
  background: #ebebeb;
}

.card-image .image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.placeholder {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ebebeb;
}

.placeholder-text {
  font-size: 24rpx;
  color: #b5b5b5;
}

/* Sold Out — top right, dark bg */
.badge-sold {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  border-radius: 4rpx;
}

/* Preorder — top right */
.badge-preorder {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 4rpx;
}

.card-body {
  padding: 16rpx 20rpx 24rpx;
}

.brand-name {
  display: block;
  font-size: 20rpx;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}

.product-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #c75c2a;
  letter-spacing: 0.02em;
}
