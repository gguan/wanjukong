.product-card {
  background: #f5f5f5;
  overflow: hidden;
}

.card-image {
  position: relative;
  width: 100%;
  padding-top: 125%; /* 4:5 aspect ratio */
  background: #ebebeb;
}

.card-image .image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.placeholder {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ebebeb;
}

.placeholder-text {
  font-size: 24rpx;
  color: #b5b5b5;
}

/* SOLD OUT — top right, solid black, rounded */
.badge-sold {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 18rpx;
  background: #000000;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  border-radius: 8rpx;
}

/* PRE ORDER — top right, solid black, rounded */
.badge-preorder {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 18rpx;
  background: #000000;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: 8rpx;
}

/* Card body — white background */
.card-body {
  padding: 20rpx 20rpx 28rpx;
  background: #ffffff;
}

.brand-name {
  display: block;
  font-size: 20rpx;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 6rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #c75c2a;
  letter-spacing: 0.02em;
}
