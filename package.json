{
  "name": "wanjukong",
  "version": "0.1.0",
  "private": true,
  "description": "Wanjukong monorepo - Nuxt 3 + NestJS",
  "scripts": {
    "clean": "rm -rf apps/web/.nuxt apps/admin/.nuxt apps/api/dist",
    "dev:clean": "pnpm clean && pnpm dev",
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @wanjukong/web dev",
    "dev:api": "pnpm --filter @wanjukong/api dev",
    "dev:admin": "pnpm --filter @wanjukong/admin dev",
    "dev:miniprogram": "echo 'Open apps/miniprogram in WeChat DevTools'",
    "build": "pnpm -r run build",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"**/*.{ts,js,vue,json,md}\"",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @wanjukong/api db:generate",
    "db:migrate": "pnpm --filter @wanjukong/api db:migrate",
    "db:seed": "pnpm --filter @wanjukong/api db:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:reset": "pnpm --filter @wanjukong/api prisma migrate reset --force"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.15.0": ">=1.15.0",
      "multer@<2.1.1": ">=2.1.1",
      "form-data@<2.5.4": ">=2.5.4",
      "fast-xml-parser@<4.5.5": ">=4.5.5",
      "path-to-regexp@<0.1.13 >=0.1.0": "0.1.13"
    }
  }
}
