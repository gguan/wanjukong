# ═══════════════════════════════════════════════════════════
# Production .env for /opt/wanjukong/.env (server)
# Docker Compose reads this file automatically.
# Copy to /opt/wanjukong/.env and fill in real values.
# ═══════════════════════════════════════════════════════════

# ─── Site URLs ────────────────────────────────────────────
# NOTE: SITE_URL / API_URL / ADMIN_URL below are DOCUMENTATION ONLY. They are
# not read by any app at runtime; the real values come from the NUXT_PUBLIC_*
# vars further down. Kept here so ops / deploy scripts can reference one
# canonical list of public hostnames.
SITE_URL=https://overrealm.shop
API_URL=https://api.wanjukong.com
ADMIN_URL=https://admin.wanjukong.com

# Canonical public URL for the storefront. REQUIRED — nuxt.config.ts throws at
# boot if this resolves to localhost in production. Used for hreflang /
# sitemap / og:url / JSON-LD.
NUXT_PUBLIC_SITE_URL=https://overrealm.shop

# Browser-facing API base. Same origin as the storefront in production (Nginx
# proxies /api/ → 127.0.0.1:3001), so an empty string means "use current origin".
NUXT_PUBLIC_API_BASE=

# SSR-only internal API URL. Lets the Nuxt server process reach the API on the
# internal docker network (http://api:3001) instead of hairpinning back through
# Nginx via the public hostname.
NUXT_API_BASE_INTERNAL=http://api:3001

# PayPal Client ID exposed to the browser for the JS SDK. Must match
# PAYPAL_CLIENT_ID below.
NUXT_PUBLIC_PAYPAL_CLIENT_ID=<PayPal Live Client ID>

# ─── Express / session behaviour ──────────────────────────
# Trust-proxy hops. Default 1 matches the single-Nginx setup deploy/nginx.conf
# ships with. Raise only if you add another hop (e.g. Cloudflare in front).
TRUST_PROXY=1

# Leave empty in production — the API auto-enables `Secure` when NODE_ENV=production.
COOKIE_SECURE=

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=<生成一个强密码>

# ─── API ──────────────────────────────────────────────────
SESSION_SECRET=<生成一个 64 位随机字符串: openssl rand -hex 32>
CORS_ORIGIN=https://overrealm.shop,https://www.overrealm.shop,https://admin.wanjukong.com

# ─── Tencent Cloud COS (图片上传) ─────────────────────────
TENCENT_COS_SECRET_ID=<你的腾讯云 SecretId>
TENCENT_COS_SECRET_KEY=<你的腾讯云 SecretKey>
TENCENT_COS_BUCKET=wanjukong-1251352121
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_PUBLIC_BASE_URL=https://wanjukong-1251352121.cos.ap-shanghai.myqcloud.com

# ─── PayPal (国际支付) ────────────────────────────────────
# 上线前改为正式环境: https://api-m.paypal.com
PAYPAL_CLIENT_ID=<你的 PayPal Client ID>
PAYPAL_CLIENT_SECRET=<你的 PayPal Client Secret>
PAYPAL_BASE_URL=https://api-m.paypal.com

# ─── WeChat 小程序 ────────────────────────────────────────
WECHAT_PAY_APP_ID=<小程序 AppID>
WECHAT_APP_SECRET=<小程序 AppSecret>

# ─── WeChat Pay (微信支付) ────────────────────────────────
WECHAT_PAY_MCH_ID=<商户号>
WECHAT_PAY_API_V3_KEY=<API V3 密钥，32字节>
WECHAT_PAY_PRIVATE_KEY=<商户私钥 PEM，换行用 \n>
WECHAT_PAY_CERT_SERIAL=<商户证书序列号>
WECHAT_PAY_PUBLIC_KEY=<微信支付公钥 PEM，换行用 \n>
WECHAT_PAY_NOTIFY_URL=https://api.wanjukong.com/api/miniprogram/payment/wechat/notify

# ─── Email ────────────────────────────────────────────────
# Transport priority in MailerService: Resend > SMTP > console.

# Resend — 海外站主发件通道 (overrealm.shop)
RESEND_API_KEY=<Resend API Key, re_...>

# SMTP — 腾讯云 SES (注意: 不是 smtp.exmail.qq.com, 那是企业邮箱)
#   广州  gz-smtp.qcloudmail.com
#   新加坡 sg-smtp.qcloudmail.com
SMTP_HOST=gz-smtp.qcloudmail.com
SMTP_PORT=465
SMTP_USER=no-reply@overrealm.shop
SMTP_PASS=<SES 发件地址专属 SMTP 密码>
SMTP_FROM=no-reply@overrealm.shop

# Contact 表单转发收件箱（企业邮箱公共邮箱）
CONTACT_INBOX_EMAIL=support@overrealm.shop

# ─── Translation (可选) ───────────────────────────────────
DEEPL_API_KEY=<DeepL API Key，可留空>
