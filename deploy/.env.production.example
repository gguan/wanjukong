# ═══════════════════════════════════════════════════════════
# Production .env for /opt/wanjukong/.env (server)
# Docker Compose reads this file automatically.
# Copy to /opt/wanjukong/.env and fill in real values.
# ═══════════════════════════════════════════════════════════

# ─── Site URLs ────────────────────────────────────────────
SITE_URL=https://overrealm.shop
API_URL=https://api.wanjukong.com

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=<生成一个强密码>

# ─── API ──────────────────────────────────────────────────
SESSION_SECRET=<生成一个 64 位随机字符串: openssl rand -hex 32>
CORS_ORIGIN=https://overrealm.shop,https://www.overrealm.shop,https://admin.wanjukong.com

# ─── Tencent Cloud COS (图片上传) ─────────────────────────
TENCENT_COS_SECRET_ID=<你的腾讯云 SecretId>
TENCENT_COS_SECRET_KEY=<你的腾讯云 SecretKey>
TENCENT_COS_BUCKET=wanjukong-1251352121
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_PUBLIC_BASE_URL=https://wanjukong-1251352121.cos.ap-shanghai.myqcloud.com

# ─── PayPal (国际支付) ────────────────────────────────────
# 上线前改为正式环境: https://api-m.paypal.com
PAYPAL_CLIENT_ID=<你的 PayPal Client ID>
PAYPAL_CLIENT_SECRET=<你的 PayPal Client Secret>
PAYPAL_BASE_URL=https://api-m.paypal.com

# ─── WeChat 小程序 ────────────────────────────────────────
WECHAT_PAY_APP_ID=<小程序 AppID>
WECHAT_APP_SECRET=<小程序 AppSecret>

# ─── WeChat Pay (微信支付) ────────────────────────────────
WECHAT_PAY_MCH_ID=<商户号>
WECHAT_PAY_API_V3_KEY=<API V3 密钥，32字节>
WECHAT_PAY_PRIVATE_KEY=<商户私钥 PEM，换行用 \n>
WECHAT_PAY_CERT_SERIAL=<商户证书序列号>
WECHAT_PAY_PUBLIC_KEY=<微信支付公钥 PEM，换行用 \n>
WECHAT_PAY_NOTIFY_URL=https://api.wanjukong.com/api/miniprogram/payment/wechat/notify

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@wanjukong.com
SMTP_PASS=<QQ 企业邮箱授权码>
SMTP_FROM=noreply@wanjukong.com

# ─── 腾讯云验证码 TCaptcha (Admin 登录防暴力破解) ─────────
# 腾讯云控制台 → 验证码 → 应用管理 → 获取 AppID 和 AppSecretKey
TCAPTCHA_APP_ID=<验证码 AppID>
TCAPTCHA_APP_SECRET_KEY=<验证码 AppSecretKey>

# ─── Translation (可选) ───────────────────────────────────
DEEPL_API_KEY=<DeepL API Key，可留空>
