# Site — dual domain setup
# overrealm.shop = web (international)
# wanjukong.com  = api + admin + miniprogram
SITE_URL=https://overrealm.shop
API_URL=https://api.wanjukong.com
ADMIN_URL=https://admin.wanjukong.com

# PostgreSQL
POSTGRES_PASSWORD=change-me

# API
SESSION_SECRET=change-me
CORS_ORIGIN=https://overrealm.shop,https://admin.wanjukong.com

# Tencent COS
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_BASE_URL=

# PayPal (International)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# WeChat Mini Program
WECHAT_PAY_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=

# WeChat Pay
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_NOTIFY_URL=https://api.wanjukong.com/api/miniprogram/payment/wechat/notify

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
