# Site — dual domain setup
# overrealm.shop = web (international)
# wanjukong.com  = api + admin + miniprogram
SITE_URL=https://overrealm.shop
API_URL=https://api.wanjukong.com
ADMIN_URL=https://admin.wanjukong.com

# PostgreSQL
POSTGRES_PASSWORD=change-me

# API
SESSION_SECRET=change-me
CORS_ORIGIN=https://overrealm.shop,https://admin.wanjukong.com

# Tencent COS
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_BASE_URL=

# PayPal (International)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# WeChat Mini Program
WECHAT_PAY_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=

# WeChat Pay
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL=
# WeChat Pay platform public key (PEM). Download from WeChat Pay console
# (商户平台 → 账户中心 → API 安全 → 平台公钥). REQUIRED in production:
# without it, payment notification signatures cannot be verified and
# the server will reject all callbacks (see main.ts startup check).
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.wanjukong.com/api/miniprogram/payment/wechat/notify

# Email. Transport priority: Resend > SMTP > console.
# Set RESEND_API_KEY for the 海外 Over Realm domain (Resend), or SMTP_* for
# 国内 SES (e.g. 腾讯云). SMTP_FROM must be on a verified domain for both.
RESEND_API_KEY=
# 腾讯云 SES SMTP endpoint 按地域选: gz-smtp / sg-smtp / smtp .qcloudmail.com
# (不是 smtp.exmail.qq.com — 那是企业邮箱)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# Where /api/public/contact forwards customer submissions (falls back to SMTP_FROM).
CONTACT_INBOX_EMAIL=

# Translation (DeepL Free API — 500k chars/month free)
# https://www.deepl.com/pro-api → sign up → get API key
DEEPL_API_KEY=
